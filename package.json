{
  "name": "@cryptidbleh/glasspane",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Native apps in JavaScript: WinUI on Windows, SwiftUI on macOS",
  "main": "lib/index.js",
  "types": "index.d.ts",
  "os": [
    "win32",
    "darwin"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "lib",
    "scripts",
    "index.d.ts",
    "native/Host/*.cs",
    "native/Host/*.csproj",
    "native/Host/app.manifest",
    "native/MacHost/Package.swift",
    "native/MacHost/Sources"
  ],
  "scripts": {
    "build": "node scripts/build-host.js",
    "build:windows": "node scripts/build-host.js --windows",
    "build:macos": "node scripts/build-host.js --macos",
    "build:host": "node scripts/build-host.js",
    "start": "glasspane examples/counter.js",
    "test": "node test/run.js"
  },
  "license": "MIT",
  "bin": {
    "glasspane": "bin/glasspane.js"
  },
  "dependencies": {
    "rcedit": "^4.0.1"
  }
}
